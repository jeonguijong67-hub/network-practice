.tmp/
__pycache__/
*.py[cod]
.pytest_cache/

# Packet captures can contain browsing/private DNS data. Review before adding.
*.pcap
*.pcapng


# Exceptions: these three captures are committed on purpose. All were taken with
# a narrow capture filter and audited before committing - see NOTES.md.
#   dns.pcapng  6 packets, one name, four DNS servers
#   tcp.pcapng  one TCP stream, headers only (editcap -s 96), no payload
#   dhcp.pcapng 5 packets, all chaddr = this laptop's MAC, no other host
!w03-dns/out/dns.pcapng
!w04-tcp/out/tcp.pcapng
!w05-ip-nat/out/dhcp.pcapng
